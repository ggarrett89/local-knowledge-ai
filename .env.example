# Copy to .env and adjust. The .env file must never be versioned.
# All variables are optional; the values below are the defaults.

# --- Data (relative paths are resolved from the working directory) ---
LKA_DATA_DIR=./data
# If omitted, these derive from LKA_DATA_DIR:
# LKA_DOCUMENTS_DIR=./data/documents
# LKA_VECTOR_DB_DIR=./data/vector_db
# LKA_CACHE_DIR=./data/cache
# LKA_METADATA_DB_PATH=./data/metadata.db
# Categories registered on first use (any extra slug can be created from the CLI):
# LKA_CATEGORIES_FILE=./config/categories.json

# --- Ollama (local LLM and embeddings runtime) ---
# Keep this on a loopback address: document text is sent to it for embedding.
LKA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LKA_CHAT_MODEL=qwen2.5:3b
# The embeddings model AND the prefixes below are part of the index identity.
# Changing any of them requires a new index in a fresh LKA_DATA_DIR (see README).
LKA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text expects task prefixes. Set both to empty for models without them.
# (A trailing space is significant; quote the value if your tooling strips it.)
LKA_EMBEDDING_DOCUMENT_PREFIX="search_document: "
LKA_EMBEDDING_QUERY_PREFIX="search_query: "
LKA_OLLAMA_TIMEOUT_SECONDS=120

# --- Ingestion (sizes are in characters; overlap must be below half the chunk size) ---
# Measured with nomic-embed-text: numeric-heavy text fails above ~2,000-3,000 characters per chunk.
# Re-run scripts/probe_embedding_context.py before raising LKA_CHUNK_SIZE above ~2000.
LKA_CHUNK_SIZE=1200
LKA_CHUNK_OVERLAP=200
LKA_EMBED_BATCH_SIZE=16

# --- Retrieval (cosine distance: 0 = same direction, 2 = opposite; lower is closer) ---
LKA_RETRIEVAL_K=5
LKA_RETRIEVAL_MAX_K=50
# Hits farther than this are dropped. 0.45 was measured with nomic-embed-text (see README);
# 0.40 is stricter, 2.0 keeps everything. It is NOT a probability and is specific to the model.
LKA_RELEVANCE_MAX_DISTANCE=0.45
# Drop chunks that sit next to an already selected chunk of the same document.
LKA_DEDUPE_ADJACENT=true
LKA_MAX_QUERY_CHARS=1000

# --- Chat / RAG ---
LKA_CHAT_TIMEOUT_SECONDS=300
# Context window in tokens. Memory grows with it. The prompt (passages + rules) must fit well inside it.
LKA_CHAT_NUM_CTX=4096
LKA_CHAT_MAX_TOKENS=600
LKA_CHAT_TEMPERATURE=0.1
# Characters of retrieved passages shown to the model. 6000 is about 2,000-2,800 tokens of prose.
LKA_RAG_CONTEXT_CHARS=6000

# --- API ---
# In the VM use 0.0.0.0: Vagrant forwards the port only to the host's 127.0.0.1.
LKA_API_HOST=127.0.0.1
LKA_API_PORT=8000
LKA_API_MAX_BODY_BYTES=65536
# Token (at least 16 characters) required by ingest and delete. Empty = those endpoints are disabled (403).
# Generate a long random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# LKA_ADMIN_TOKEN=
